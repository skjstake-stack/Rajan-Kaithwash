{
  "entities": {
    "Booking": {
      "title": "Booking",
      "description": "User consultation booking details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 15 },
        "email": { "type": "string", "maxLength": 100 },
        "serviceId": { "type": "string", "maxLength": 50 },
        "serviceTitle": { "type": "string", "maxLength": 150 },
        "preferredDate": { "type": "string", "maxLength": 20 },
        "preferredTime": { "type": "string", "maxLength": 20 },
        "birthDetails": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "phone", "serviceId", "createdAt"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Contact form enquiry or message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 10, "maxLength": 15 },
        "message": { "type": "string", "minLength": 2, "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone", "message", "createdAt"]
    },
    "KundliRecord": {
      "title": "KundliRecord",
      "description": "User saved birth chart record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "dob": { "type": "string", "maxLength": 20 },
        "tob": { "type": "string", "maxLength": 20 },
        "pob": { "type": "string", "maxLength": 100 },
        "lagna": { "type": "string", "maxLength": 50 },
        "rashi": { "type": "string", "maxLength": 50 },
        "nakshatra": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["name", "dob", "tob", "pob", "createdAt"]
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "User consultation bookings"
    },
    "/enquiries/{enquiryId}": {
      "schema": { "$ref": "#/entities/Enquiry" },
      "description": "User contact form messages"
    },
    "/kundli_records/{kundliId}": {
      "schema": { "$ref": "#/entities/KundliRecord" },
      "description": "Saved Kundli birth charts"
    }
  }
}
